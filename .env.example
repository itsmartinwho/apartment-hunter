TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Same small text helper configuration as jev-ultrafast; values and keys stay on the server.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# OpenRouter key for the vision model. TEXT_MODEL_API_KEY from jev-ultrafast also works.
VISION_API_KEY=
VISION_MODEL=google/gemini-2.5-flash-lite
VISION_BASE_URL=https://openrouter.ai/api/v1
# user: your running Chrome (click Allow once per connection). dedicated: a separate Chrome profile on port 9333.
CHROME_MODE=user
HUNTER_PORT=8777
